# Copy this file to `.env` in the same folder (backend/.env). Never commit real values.

PORT=5000

# MongoDB Atlas (or other) connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

# Long random secret for signing JWTs (min 32 chars in production). Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or: npm run set-jwt-secret
JWT_SECRET=

# Optional: comma-separated allowed browser origins (recommended in production).
# Example: https://yourapp.vercel.app,https://www.yourdomain.com
# Leave unset to allow any origin (fine for local dev only).
# CORS_ORIGIN=

# Set to `production` on the live server so weak config is rejected at startup.
# NODE_ENV=production
